"/></mxCell><mxCell id="A06" value="A06 «API»&#xa;Quản lý bản phát hành nội dung" style="ellipse;whiteSpace=wrap;html=0;fillColor=#f3f5f7;strokeColor=#16202b;fontSize=18;" vertex="1" parent="system"><mxGeometry x="700" y="733.5" width="360" height="70" as="geometry"/></mxCell><mxCell id="edge-A06" style="endArrow=none;startArrow=none;html=0;strokeColor=#526070;" edge="1" parent="1" source="Admin" target="A06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="A07" value="A07 «API»&#xa;Quản lý tài nguyên nội dung" style="ellipse;whiteSpace=wrap;html=0;fillColor=#f3f5f7;strokeColor=#16202b;fontSize=18;" vertex="1" parent="system"><mxGeometry x="700" y="859.2" width="360" height="70" as="geometry"/></mxCell><mxCell id="edge-A07" style="endArrow=none;startArrow=none;html=0;strokeColor=#526070;" edge="1" parent="1" source="Admin" target="A07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="A08" value="A08 «API»&#xa;Xem nhật ký quản trị" style="ellipse;whiteSpace=wrap;html=0;fillColor=#f3f5f7;strokeColor=#16202b;fontSize=18;" vertex="1" parent="system"><mxGeometry x="700" y="984.9000000000001" width="360" height="70" as="geometry"/></mxCell><mxCell id="edge-A08" style="endArrow=none;startArrow=none;html=0;strokeColor=#526070;" edge="1" parent="1" source="Admin" target="A08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="«API»: Backend đã có; chưa có màn hình Admin tương ứng.&#xa;Đăng nhập/quyền hợp lệ là tiền điều kiện. Khôi phục mật khẩu phụ thuộc cấu hình.&#xa;User và Admin độc lập; không gồm parent/kid và commerce cũ." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry x="230" y="1250" width="1140" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>